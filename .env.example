# Discord
DISCORD_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
# Used by the optional command registration script
DISCORD_CLIENT_ID=replace_me

# Dev helper (set true to run container without connecting to Discord)
DISCORD_DISABLE_LOGIN=false

# Authorization (optional)
# Comma-separated Discord user IDs allowed to run destructive actions (start/stop/restart)
DISCORD_SUPERUSER_IDS=

# Docker safety
# Comma-separated docker compose service names the bot is allowed to operate on
DOCKER_ALLOW_SERVICES=mc-prod,mc-test

# Minecraft RCON (internal only)
MC_PROD_RCON_HOST=mc-prod
MC_PROD_RCON_PORT=25575
MC_PROD_RCON_PASSWORD=replace_me

MC_TEST_RCON_HOST=mc-test
MC_TEST_RCON_PORT=25575
MC_TEST_RCON_PASSWORD=replace_me
