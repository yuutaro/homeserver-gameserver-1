# Discord
DISCORD_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
# Used by the optional command registration script
DISCORD_CLIENT_ID=replace_me

# Dev helper (set true to run container without connecting to Discord)
DISCORD_DISABLE_LOGIN=false

# Data directory (same absolute path on both the bot container and the docker host)
# In production, keep it under the project directory and create:
#   ${DATA_DIR}/<server-name>/server.env
DATA_DIR=/opt/homeserver-gameserver-1/data

# Minecraft container settings (managed by the bot via docker.sock)
MC_CONTAINER_NAME=mc-prod
MC_IMAGE=itzg/minecraft-server:latest
MC_NETWORK=gameserver-net
MC_HOST_PORT=30002

# Optional: show connection destination in bot replies
# If unset, the bot will only show the port.
MC_CONNECT_IP=
# Prefer this for your home domain (not necessarily DDNS)
MC_CONNECT_HOST=example.com
# Backward compatible alias (deprecated)
MC_CONNECT_DDNS=

# Minecraft RCON (internal only; password is read from /data/<server-name>/server.env)
MC_RCON_HOST=mc-prod
MC_RCON_PORT=25575

# Optional: stop mc-prod before a scheduled host reboot (JST, fixed UTC+09:00)
# If enabled, the bot will attempt RCON save/stop and then remove the container.
PRE_REBOOT_STOP_ENABLED=false
PRE_REBOOT_STOP_TIME_JST=08:55
PRE_REBOOT_STOP_GRACE_MINUTES=30

# Optional: announce upcoming stop in-game via RCON
PRE_REBOOT_ANNOUNCE_ENABLED=true
PRE_REBOOT_ANNOUNCE_MINUTES_BEFORE=5
PRE_REBOOT_COUNTDOWN_SECONDS=30
