# Discord
DISCORD_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
DISCORD_CLIENT_ID=replace_me

# Keep this true outside production so a local bot never logs in with the
# production token by accident.
DISCORD_DISABLE_LOGIN=true
ALLOW_NON_PROD_DISCORD_LOGIN=false

# Same absolute path in the bot container and on the Docker host.
# Each ${DATA_DIR}/<server-id>/ directory must contain server.env.
DATA_DIR=/opt/homeserver-gameserver-1/data

# One shared runtime slot for every supported game.
GAMESERVER_CONTAINER_NAME=gameserver-prod
GAMESERVER_NETWORK=gameserver-net

# Minecraft driver
MC_IMAGE=itzg/minecraft-server:latest
MC_HOST_PORT=30002

# Optional connection destination shown in Discord replies.
MC_CONNECT_IP=
MC_CONNECT_HOST=example.com
MC_CONNECT_DDNS=

# Minecraft RCON uses the shared container name on the internal Docker network.
MC_RCON_PORT=25575

# Optional: stop the active game server before a scheduled host reboot.
PRE_REBOOT_STOP_ENABLED=false
PRE_REBOOT_STOP_TIME_JST=08:55
PRE_REBOOT_STOP_GRACE_MINUTES=30

# Optional in-game announcement through the active game's driver.
PRE_REBOOT_ANNOUNCE_ENABLED=true
PRE_REBOOT_ANNOUNCE_MINUTES_BEFORE=5
PRE_REBOOT_COUNTDOWN_SECONDS=30
