# Separate from bot.env. Copy to config/pack-release.env (gitignored), chmod 600.
# Absolute paths; no shell expansion/interpolation. Do not point outputs at the source.
PACK_DATA_DIR=/path/to/production/data
PACK_OUTPUT_DIR=/path/to/private/release-artifacts
PACK_REPOSITORY=yuutaro/homeserver-gameserver-1
# Prefer existing gh auth login. Only for unattended operation, optional:
# GH_TOKEN=
